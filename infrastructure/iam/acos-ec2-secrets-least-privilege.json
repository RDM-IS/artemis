{
  "_comment": [
    "PROPOSED — NOT APPLIED. Replaces the AWS-managed SecretsManagerReadWrite",
    "policy on acos-ec2-role. See docs/ARTEMIS_STATE.md (SECRETS-LP) for what",
    "it covers, what it deliberately drops, and what would break.",
    "Attach with: aws iam put-role-policy --role-name acos-ec2-role",
    "  --policy-name acos-secrets-read --policy-document file://<this file>",
    "then: aws iam detach-role-policy --role-name acos-ec2-role",
    "  --policy-arn arn:aws:iam::aws:policy/SecretsManagerReadWrite",
    "2026-09-21: + rdmis/dev/notion-token (DIET-1, #145). get_notion_token() returns None",
    "  on ANY failure, so a missing grant would silently mean 'no meal plan' every day."
  ],
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheSecretsTheBoxActuallyUses",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rds!db-bfe5d90f-e0f3-4517-8f16-937001f970dc-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/anthropic-api-key-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/mattermost-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/gmail-oauth-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/gmail-token-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/calendar-token-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/booking-links-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/crm-api-key-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/openweather-api-key-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:acos/vault-repo-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/notion-token-*"
      ]
    },
    {
      "Sid": "RefreshTheTwoOAuthTokensTheBoxRotates",
      "Effect": "Allow",
      "Action": "secretsmanager:PutSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/gmail-token-*",
        "arn:aws:secretsmanager:us-east-1:095652687153:secret:rdmis/dev/calendar-token-*"
      ]
    }
  ]
}
