# Secrets and credentials — NEVER on disk (CLAUDE.md). Only non-secret config
# lives in .env; .env.example* stays TRACKED as the documented shape.
.env
.env.bak*
credentials.json
token.json
calendar_token.json

# Private data that must never reach a public repo. artemis is public: the
# dossiers under scripts/seed_data/ name real people, so the directory is
# ignored and only its README is tracked (2026-09-28).
scripts/seed_data/*
!scripts/seed_data/README.md

# Per-machine editor/agent state.
.claude/settings.local.json

# Handoff notes and round reports. These quote real logged sessions -- dates,
# set counts, session spans -- to reason about the plan, and artemis is public.
# The Mac had this in .git/info/exclude, which is per-clone: the box and any
# fresh clone had no such protection, so one `git add -A` there would have
# published real health data. An ignore rule only helps where it is committed
# (2026-09-28).
.claude/handoff/

# Retired store — SQLite is gone and tests guard against its return.
artemis.db

# Build and packaging artefacts.
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/
venv/
api/package/
api/function.zip
lambda.zip

# Local scratch that must not reach a public repo. Explicit rather than broad:
# nothing tracked matches any of these (checked 2026-09-28 — `git ls-files '*.log'`
# is empty, and no tracked file is named ddl.py, introspect.py or sample.py), and
# the three probes are ROOT-ANCHORED so a real module of the same name elsewhere in
# the tree is still seen. commitments_backup_*.json carries client names.
*.log
commitments_backup_*.json
/ddl.py
/introspect.py
/sample.py

# OS and stray files.
.DS_Store
UQ3o
